specs ({
    name pgorm,
    include (docs/spec/**/*.md),
    impls (
        {
            name main,
            languages (@rust @python),
            include (
                src/**/*.rs
                pgorm-macros/src/**/*.rs
                pgorm-codegen/src/**/*.rs
                pgorm-migration/src/**/*.rs
                pgorm-pool/src/**/*.rs
                pgorm-query/src/**/*.rs
                pgorm-query/pgorm-query-attr/src/**/*.rs
                pgorm-query/pgorm-query-derive/src/**/*.rs
                pgorm-sql-macro/src/**/*.rs
                pgorm-test-support/src/**/*.rs
                pgorm-guide-support/src/**/*.rs
                security/sqlmap/adapter/src/**/*.rs
                .github/workflows/sqlmap*.yml
                security/sqlmap/acceptance/*.md
                security/generative/src/**/*.py
                security/generative/check.py
                security/generative/ci.py
                security/generative/bridge/src/**/*.rs
                security/generative/replay/src/**/*.rs
                security/generative/compile/src/**/*.rs
                .github/workflows/generative*.yml
            ),
            test_include (
                tests/**/*.rs
                pgorm-macros/tests/**/*.rs
                pgorm-codegen/tests/**/*.rs
                pgorm-migration/tests/**/*.rs
                pgorm-pool/tests/**/*.rs
                pgorm-query/tests/**/*.rs
                pgorm-query/pgorm-query-attr/tests/**/*.rs
                pgorm-query/pgorm-query-derive/tests/**/*.rs
                pgorm-sql-macro/tests/**/*.rs
                pgorm-test-support/tests/**/*.rs
                pgorm-guide-support/tests/**/*.rs
                security/sqlmap/adapter/tests/**/*.rs
                security/generative/tests/**/*.py
                security/generative/bridge/tests/**/*.rs
            ),
            exclude (
                target/**
            )
        }
        {
            name python,
            languages (@rust @python),
            include (
                pgorm-python/src/**/*.rs
                pgorm-python/python/**/*.py
                pgorm-python/checks/**/*.py
                pgorm-python/guide/**/*.py
            ),
            test_include (
                pgorm-python/tests/**/*.rs
                pgorm-python/tests/**/*.py
            ),
            exclude (
                target/**
            )
        }
        {
            name javascript,
            languages (@rust @javascript @typescript),
            include (
                pgorm-napi/src/**/*.rs
                pgorm-napi/lib/**/*.js
                pgorm-napi/lib/**/*.ts
                pgorm-napi/checks/**/*.js
                pgorm-napi/codegen/**/*.js
                .github/workflows/napi.yml
            ),
            test_include (
                pgorm-napi/tests/**/*.ts
                pgorm-napi/tests/**/*.rs
            ),
            exclude (
                target/**
            )
        }
    )
})
