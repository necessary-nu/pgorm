                    {
                        at 2026-10-19T13:20:35.498187Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "like-ilike-render-parens (26b39edf) bumped sql.render.precedence+10: the LIKE family is LIKE, NOT LIKE, ILIKE, NOT ILIKE, SIMILAR TO and NOT SIMILAR TO, so ILIKE renders bare under AND/OR/NOT as LIKE does (Oper::is_like gained ILike/NotILike); every site re-read and re-pinned, and the renderer matches."
                        after_done true
                    }

                    {
                        at 2026-10-19T13:36:54.368904Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "sql.render.subquery +5 (in-subquery-enum-shapes, a4b9cbd2): a SimpleExpr::SubQuery's operator prefix includes ARRAY, rendered directly before the parenthesized sub-statement."
                        after_done true
                    }

                    {
                        at 2026-10-23T20:33:52.917041Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "boolean-operator-parens (d5a931eb) and between-render-parens (6ff68b71) bumped sql.render.precedence+12 (&&, ~ and ~* join the boolean-valued set; the BETWEEN family renders bare under AND/OR/NOT) and sql.render.parens+4 (BETWEEN's bounds are operands of the BETWEEN, not of its AND); every site re-read and re-pinned, and the renderer, now in query_builder/precedence.rs, matches."
                        after_done true
                    }

                    {
                        at 2026-10-25T22:08:39.694439Z
                        author "brendan@necessary.nu"
                        kind @decision
                        text "Operator 2026-10-25, asked whether nested logical operators should drop the parentheses the grammar does not need ((a AND b) OR c rendered a AND b OR c; NOT under AND/OR): \"keep parens\". AND under OR and NOT under AND/OR keep their parentheses for readability; boolean-operator-parens and between-render-parens changed only the comparison-family operands under logic."
                        after_done true
                    }
                )
