            {
                id column-default-parens
                title "A column DEFAULT that is an operator expression renders parenthesised, so CREATE TABLE accepts it"
                kind @fix
                deps (sql-domains)
                log (
                    {
                        at 2026-10-18T21:52:40.048769Z
