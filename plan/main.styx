    {
        id typed-binds
        title "Every bound value is cast to its column's type, whichever path binds it: a binding's predicate, a pipeline column read by name, a created range"
        kind @fix
        children (
            {
                id bindings-between-casts
                title "between on a binding's registered column binds its values under the column's casts"
                kind @fix
                deps (money-beyond-entities)
