from .transactions import Transaction
from typing import Any, TypeAlias, Never
from collections.abc import Awaitable, Sequence
from typing import Literal
from ._native import Compiled, Condition, Expr, OrderBy
from ._entity_reads import EntityPaginator
from ._entity_models import EntityModel
from .results import RowStream
from .runtime import Connection, Pool

GraphRow: TypeAlias = EntityModel | tuple[EntityModel | None, ...]

class EntityGraph:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def name(self) -> str: ...
    def describe(self, /) -> dict[str, Any]: ...
    def find(self, /, *, aliases: Sequence[str] | None = ...) -> EntityGraphQuery: ...

class EntityGraphQuery:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def graph_name(self) -> str: ...
    def col(self, /, source: int, column: str) -> Expr: ...
    def where(self, /, predicate: Expr | Condition) -> EntityGraphQuery: ...
    def order_by(self, /, *ordering: OrderBy) -> EntityGraphQuery: ...
    def inspect(self, /, *, terminal: Literal["all", "optional", "count"] = ...) -> Compiled: ...
    def cursor(self, /, *columns: str) -> EntityGraphCursor: ...
    def cursor_on(self, /, source: int, *columns: str) -> EntityGraphCursor: ...
    def all(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[GraphRow]]: ...
    def optional(self, /, connection: Pool | Connection | Transaction) -> Awaitable[GraphRow | None]: ...
    def all_grouped(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[tuple[EntityModel, list[EntityModel]]]]: ...
    def count(self, /, connection: Pool | Connection | Transaction) -> Awaitable[int]: ...
    def stream(self, /, connection: Pool | Connection) -> Awaitable[RowStream[GraphRow]]: ...
    def paginate(self, /, page_size: int) -> EntityPaginator[GraphRow]: ...
    def __bool__(self, /) -> bool: ...

class EntityGraphCursor:
    def __init__(self, _native_only: Never, /) -> None: ...
    def before(self, /, *values: Any) -> EntityGraphCursor: ...
    def after(self, /, *values: Any) -> EntityGraphCursor: ...
    def before_with(self, /, *values: Any) -> EntityGraphCursor: ...
    def after_with(self, /, *values: Any) -> EntityGraphCursor: ...
    def first(self, /, count: int) -> EntityGraphCursor: ...
    def last(self, /, count: int) -> EntityGraphCursor: ...
    def asc(self, /) -> EntityGraphCursor: ...
    def desc(self, /) -> EntityGraphCursor: ...
    def inspect(self, /) -> Compiled: ...
    def all(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[GraphRow]]: ...
    def __bool__(self, /) -> bool: ...

def graph(name: str) -> EntityGraph: ...
def graphs() -> list[str]: ...
