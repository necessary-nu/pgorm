from .transactions import Transaction
from typing import Any, Literal, Never
from collections.abc import Awaitable, Sequence
from ._native import Expr, Condition, Compiled, Join, OrderBy, RawSQL, Select
from ._entity_raw import EntityRawQuery
from ._entity_models import ActiveModel, EntityModel
from ._entity_columns import EntityColumn as EntityColumn
from ._entity_reads import EntityCursor, EntityPaginator, EntityRelation, EntitySelection
from ._versions import EntityInsert, EntityInsertMany, EntityUpdate, EntityUpdateMany
from .results import RowStream
from .runtime import Connection, Pool

class Entity:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def name(self) -> str: ...
    def describe(self, /) -> dict[str, Any]: ...
    def col(self, /, name: str) -> EntityColumn: ...
    def find(self, /) -> EntityQuery: ...
    def relation(self, /, name: str) -> EntityRelation: ...
    def active(self, /) -> ActiveModel: ...
    def update(self, /, active: ActiveModel) -> EntityUpdate: ...
    def update_many(self, /) -> EntityUpdateMany: ...
    def insert(self, /, active: ActiveModel) -> EntityInsert: ...
    def insert_many(self, /, actives: Sequence[ActiveModel]) -> EntityInsertMany: ...

class EntityQuery:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def entity_name(self) -> str: ...
    def where(self, /, predicate: Expr | Condition) -> EntityQuery: ...
    def order_by(self, /, *ordering: OrderBy) -> EntityQuery: ...
    def limit(self, /, value: int | None = ...) -> EntityQuery: ...
    def offset(self, /, value: int | None = ...) -> EntityQuery: ...
    def inspect(self, /, *, terminal: Literal["all", "one", "optional", "count"] = ...) -> Compiled: ...
    def join(self, /, relation: EntityRelation, *, kind: Join = ...) -> EntityQuery: ...
    def select(self, /, *columns: str) -> EntitySelection: ...
    def all(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[EntityModel]]: ...
    def one(self, /, connection: Pool | Connection | Transaction) -> Awaitable[EntityModel]: ...
    def optional(self, /, connection: Pool | Connection | Transaction) -> Awaitable[EntityModel | None]: ...
    def count(self, /, connection: Pool | Connection | Transaction) -> Awaitable[int]: ...
    def from_raw_sql(self, /, statement: RawSQL) -> EntityRawQuery: ...
    def stream(self, /, connection: Pool | Connection) -> Awaitable[RowStream[EntityModel]]: ...
    def paginate(self, /, page_size: int) -> EntityPaginator[EntityModel]: ...
    def cursor(self, /, *columns: str) -> EntityCursor: ...
    def __bool__(self, /) -> bool: ...

def entity(name: str) -> Entity: ...
def entities() -> list[str]: ...
