from .transactions import Transaction
from typing import Never
from collections.abc import Awaitable
from ._native import Compiled
from ._entity_models import EntityModel
from .runtime import Connection, Pool

class EntityRawQuery:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def entity_name(self) -> str: ...
    def inspect(self, /) -> Compiled: ...
    def all(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[EntityModel]]: ...
    def one(self, /, connection: Pool | Connection | Transaction) -> Awaitable[EntityModel]: ...
    def optional(self, /, connection: Pool | Connection | Transaction) -> Awaitable[EntityModel | None]: ...
    def __bool__(self, /) -> bool: ...
