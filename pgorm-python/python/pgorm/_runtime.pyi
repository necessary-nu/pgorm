from collections.abc import Awaitable, Callable, Mapping, Sequence
from typing import Any, Literal, Never, overload

from ._listen import _Listener
from ._disjoint import _Disjoint
from ._entity_reads import _RowDecoder
from ._results import Record

STATEMENT_CACHE_CHANNEL: str

class _PoolShape:
    def __init__(self, *, max_size: int = ..., acquire_timeout: float = ...,
                 wait_timeout: float | None = ..., create_timeout: float | None = ...,
                 recycle_timeout: float | None = ..., queue_mode: str = ...,
                 post_create: Callable[[_HookConnection], Awaitable[None]] | None = ...,
                 pre_recycle: Callable[[_HookConnection], Awaitable[None]] | None = ...,
                 post_recycle: Callable[[_HookConnection], Awaitable[None]] | None = ...) -> None: ...

class _HookConnection:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def age(self) -> float: ...
    @property
    def recycle_count(self) -> int: ...
    def closed(self, /) -> bool: ...
    def execute(self, /, query: Any) -> Awaitable[int]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["all"]) -> Awaitable[list[Record]]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["one"]) -> Awaitable[Record]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["optional"]) -> Awaitable[Record | None]: ...

class _Pool:
    def __init__(self, dsn: str, shape: _PoolShape, *, tag: str | None = ..., tls: str | None = ...,
                 ca_pem: bytes | None = ..., cert_pem: bytes | None = ..., key_pem: bytes | None = ...,
                 connect_timeout: float = ..., statement_cache_size: int = ..., recycle: str = ...,
                 recycle_sql: str | None = ..., statement_cache_channel: str | None = ...) -> None: ...
    @staticmethod
    def multi(dsn: str, shapes: Mapping[str, _PoolShape], *, tls: str | None = ...,
              ca_pem: bytes | None = ..., cert_pem: bytes | None = ..., key_pem: bytes | None = ...,
              connect_timeout: float = ..., statement_cache_size: int = ..., recycle: str = ...,
              recycle_sql: str | None = ...,
              statement_cache_channel: str | None = ...) -> list[tuple[str, _Pool]]: ...
    def tag(self, /) -> str: ...
    def acquire(self, /) -> Awaitable[_Connection]: ...
    def close(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...
    def status(self, /) -> tuple[int, int, int, int]: ...
    def clear_statement_caches(self, /) -> None: ...
    def listener(self, /, capacity: int = ...) -> Awaitable[_Listener]: ...
    def instrumented(
        self, /, hooks: Sequence[Callable[..., object] | None],
        dispatch: Callable[[str, Callable[..., object], tuple[object, ...], Callable[[], None]], None],
    ) -> _Pool: ...

class _Connection:
    def __init__(self, _native_only: Never, /) -> None: ...
    def begin(self, /, *, mode: str = ..., isolation: str | None = ...) -> Awaitable[_Transaction]: ...
    def ping(self, /) -> Awaitable[bool]: ...
    def close(self, /) -> Awaitable[None]: ...
    def discard(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...
    def execute(self, /, query: Any) -> Awaitable[int]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["all"]) -> Awaitable[list[Record]]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["one"]) -> Awaitable[Record]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["optional"]) -> Awaitable[Record | None]: ...
    def stream(self, /, query: Any, decoder: _Disjoint | _RowDecoder | None = ...) -> Awaitable[_Stream]: ...
    def notify(self, /, channel: str, payload: str) -> Awaitable[None]: ...

class _Stream:
    def __init__(self, _native_only: Never, /) -> None: ...
    def next(self, /) -> Awaitable[Record | Any | None]: ...
    def close(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...

class _Transaction:
    def __init__(self, _native_only: Never, /) -> None: ...
    def begin(self, /) -> Awaitable[_Transaction]: ...
    def finish(self, /, commit: bool) -> Awaitable[None]: ...
    def wait_closed(self, /) -> Awaitable[None]: ...
    def closed(self, /) -> bool: ...
    def owner_matches(self, /, parent: object) -> bool: ...
    def abort(self, /) -> Awaitable[None]: ...
    def execute(self, /, query: Any) -> Awaitable[int]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["all"]) -> Awaitable[list[Record]]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["one"]) -> Awaitable[Record]: ...
    @overload
    def fetch(self, /, query: Any, mode: Literal["optional"]) -> Awaitable[Record | None]: ...
    def notify(self, /, channel: str, payload: str) -> Awaitable[None]: ...
