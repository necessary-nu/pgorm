from typing import Any, ClassVar, Generic, Never, TypeVar
from collections.abc import Awaitable, Sequence
from ._native import Expr, Condition
from ._entities import EntityColumn
from ._entity_models import ActiveModel, EntityModel
from ._writes import Conflict, ConflictUpdate
from ._entity_try_inserts import EntityTryInsert, EntityTryInsertMany
from .runtime import Connection, Pool
from .transactions import Transaction

# The record a write reads its rows as: an EntityModel, a ModelRecord, or a
# generated view's model. Any where none is named, so `pgorm.Change` holds
# each.
M = TypeVar("M", covariant=True, default=Any)
N = TypeVar("N", covariant=True, default=Any)

class Change(Generic[M]):
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def old(self) -> M: ...
    @property
    def new(self) -> M: ...

class Upserted(Generic[M]):
    def __init__(self, _native_only: Never, /) -> None: ...
    def into_model(self, /) -> M: ...
    class Inserted(Upserted[N]):
        __match_args__: ClassVar[tuple[str]]
        @property
        def model(self) -> N: ...
    class Updated(Upserted[N]):
        __match_args__: ClassVar[tuple[str]]
        @property
        def change(self) -> Change[N]: ...

R = TypeVar("R")

def _change(old: R, new: R) -> Change[R]: ...
def _inserted(model: R) -> Upserted.Inserted[R]: ...
def _updated(change: Change[R]) -> Upserted.Updated[R]: ...

class EntityUpdate:
    def __init__(self, _native_only: Never, /) -> None: ...
    def returning_change(self, /, connection: Pool | Connection | Transaction) -> Awaitable[Change[EntityModel]]: ...

class EntityUpdateMany:
    def __init__(self, _native_only: Never, /) -> None: ...
    def set(self, /, column: str | EntityColumn, value: Any) -> EntityUpdateMany: ...
    def where(self, /, predicate: Expr | Condition) -> EntityUpdateMany: ...
    def all_rows(self, /) -> EntityUpdateMany: ...
    def returning_changes(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[Change[EntityModel]]]: ...

class EntityInsert:
    def __init__(self, _native_only: Never, /) -> None: ...
    def on_conflict(self, /, action: Conflict | ConflictUpdate) -> EntityInsert: ...
    def on_conflict_do_nothing(self, /) -> EntityTryInsert: ...
    def on_empty_do_nothing(self, /) -> EntityTryInsert: ...
    def add(self, /, active: ActiveModel) -> EntityInsertMany: ...
    def add_many(self, /, actives: Sequence[ActiveModel]) -> EntityInsertMany: ...
    def execute(self, /, connection: Pool | Connection | Transaction) -> Awaitable[int]: ...
    def returning_pk(self, /, connection: Pool | Connection | Transaction) -> Awaitable[Any]: ...
    def returning_model(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[EntityModel]: ...
    def returning_upsert(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[Upserted.Inserted[EntityModel] | Upserted.Updated[EntityModel] | None]: ...

class EntityInsertMany:
    def __init__(self, _native_only: Never, /) -> None: ...
    def on_conflict(self, /, action: Conflict | ConflictUpdate) -> EntityInsertMany: ...
    def on_conflict_do_nothing(self, /) -> EntityTryInsertMany: ...
    def on_empty_do_nothing(self, /) -> EntityTryInsertMany: ...
    def add(self, /, active: ActiveModel) -> EntityInsertMany: ...
    def add_many(self, /, actives: Sequence[ActiveModel]) -> EntityInsertMany: ...
    def execute(self, /, connection: Pool | Connection | Transaction) -> Awaitable[int]: ...
    def returning_pks(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[list[Any]]: ...
    def returning_models(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[list[EntityModel]]: ...
    def returning_upserts(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[list[Upserted.Inserted[EntityModel] | Upserted.Updated[EntityModel]]]: ...
