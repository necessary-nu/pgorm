from collections.abc import Awaitable, Sequence
from os import PathLike

class SqlMigration:
    def __init__(self, /, name: str, sql: str) -> None: ...
    @staticmethod
    def read(path: str | PathLike[str]) -> SqlMigration: ...
    @staticmethod
    def read_dir(directory: str | PathLike[str]) -> list[SqlMigration]: ...
    @property
    def name(self) -> str: ...
    @property
    def sql(self) -> str: ...
    @property
    def checksum(self) -> str: ...
    @property
    def commits_after(self) -> bool: ...

class _Migrations:
    def __init__(
        self,
        /,
        migrations: Sequence[object],
        migration_table_name: str | None,
        migration_table_schema: str | None,
        statement_cache_channel: str | None,
    ) -> None: ...
    def up(self, /, pool: object, steps: int | None) -> Awaitable[None]: ...
    def install(self, /, executor: object) -> Awaitable[None]: ...
    def status(self, /, executor: object) -> Awaitable[list[tuple[str, bool]]]: ...

