from collections.abc import Awaitable
from typing import Any, Literal, Never, overload

from ._entity_models import ActiveModel, EntityModel
from ._native import Compiled, Select, Table, TypeName
from ._results import Record
from ._schema import MigrationFile

# A model's row: its Record, the index of its kind and the decoded source
# its kind's row is under; a registration's: its models and its kind.
_ModelItem = tuple[Record, int, int | None]
_EntityItem = tuple[EntityModel, str, EntityModel | None]

class _Disjoint:
    def __init__(self, _native_only: Never, /) -> None: ...
    def describe(self, /) -> dict[str, Any]: ...
    def kinds(self, /) -> list[str]: ...
    def key_columns(self, /) -> list[str]: ...
    def result_names(self, /, source: int) -> list[str]: ...
    def find(self, /) -> Select: ...
    def narrow_key(self, /, select: Select, key: list[Any]) -> Select: ...
    def narrow_kind(self, /, select: Select, kind: str) -> Select: ...
    def narrow_kinds(self, /, select: Select, kinds: list[str]) -> Select: ...
    def narrow_filter_kind(self, /, select: Select, kind: str, predicate: Any) -> Select: ...
    def page(self, /, select: Select, size: int, page: int) -> Select: ...
    def counted(self, /, select: Select) -> Select: ...
    def cursor(
        self, /, select: Select, columns: list[str], *, after: list[Any] | None = ...,
        before: list[Any] | None = ..., window: tuple[bool, int] | None = ...,
        descending: bool = ...,
    ) -> tuple[Select, bool]: ...
    def insert(self, /, base: list[tuple[str, Any]] | ActiveModel | None, kind: str,
               row: list[tuple[str, Any]] | ActiveModel | None = ...) -> Select: ...
    def update(self, /, base: list[tuple[str, Any]] | ActiveModel | None, kind: str,
               row: list[tuple[str, Any]] | ActiveModel | None = ...) -> Select: ...
    def change_kind(self, /, key: list[Any], kind: str,
                    row: list[tuple[str, Any]] | ActiveModel | None = ...) -> Select: ...
    @overload
    def run(self, /, db: Any, select: Select, terminal: Literal["all"]) -> Awaitable[list[Any]]: ...
    @overload
    def run(self, /, db: Any, select: Select, terminal: Literal["one", "write"]) -> Awaitable[Any]: ...
    @overload
    def run(self, /, db: Any, select: Select, terminal: Literal["count"]) -> Awaitable[int]: ...
    def inspect(self, /, select: Select, *, terminal: Literal["all", "one", "write"] = ...) -> Compiled: ...
    def statements(self, /) -> tuple[Any, ...]: ...
    def change(
        self, /, change: str, value: str, table: str | Table | None = None
    ) -> tuple[list[tuple[tuple[Any, ...], tuple[str, str | None, str] | None]], _DisjointChange]: ...

class _DisjointChange:
    def __init__(self, _native_only: Never, /) -> None: ...
    def migration_files(self, /, name: str) -> list[MigrationFile]: ...

def _disjoint_model(
    name: str,
    base: tuple[str, dict[str, Any]],
    kinded: tuple[str, str, TypeName] | None,
    kinds: list[tuple[str, tuple[str, dict[str, Any]] | None]],
) -> _Disjoint: ...
def _disjoint_entity(name: str) -> _Disjoint: ...
def _disjoint_entities() -> list[str]: ...
