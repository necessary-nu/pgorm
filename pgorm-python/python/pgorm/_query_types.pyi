from typing import ClassVar, Never
from ._native import Value
from ._expressions import Expr

def _identifier(name: str) -> str: ...

class Direction:
    def __init__(self, _native_only: Never, /) -> None: ...
    Asc: ClassVar[Direction]
    Desc: ClassVar[Direction]

class Nulls:
    def __init__(self, _native_only: Never, /) -> None: ...
    First: ClassVar[Nulls]
    Last: ClassVar[Nulls]

class Compiled:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def sql(self) -> str: ...
    @property
    def params(self) -> list[Value]: ...

class LikeExpr:
    def __init__(self, pattern: str) -> None: ...
    def escape(self, /, character: str) -> LikeExpr: ...
    def no_escape(self, /) -> LikeExpr: ...

class Aliased:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def expr(self) -> Expr: ...
    @property
    def alias(self) -> str: ...

class OrderBy:
    def __init__(self, expr: Expr, direction: Direction, *, nulls: Nulls | None = ...) -> None: ...
    @property
    def expr(self) -> Expr: ...
    @property
    def direction(self) -> Direction: ...
    @property
    def nulls(self) -> Nulls | None: ...

