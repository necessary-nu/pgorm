from typing import Any, Never, TypeVar
from collections.abc import Awaitable, Sequence
from ._entity_models import ActiveModel, EntityModel
from ._writes import Conflict, ConflictUpdate
from .models.try_inserts import TryInsertResult
from .runtime import Connection, Pool
from .transactions import Transaction

# What a try-insert's terminal answers: what it wrote, or that its conflict
# clause held every row back, or that it had nothing to write.
_T = TypeVar("_T")
_Tried = TryInsertResult.Inserted[_T] | TryInsertResult.Conflicted | TryInsertResult.Empty

class EntityTryInsert:
    def __init__(self, _native_only: Never, /) -> None: ...
    def on_conflict(self, /, action: Conflict | ConflictUpdate) -> EntityTryInsert: ...
    def add(self, /, active: ActiveModel) -> EntityTryInsertMany: ...
    def add_many(self, /, actives: Sequence[ActiveModel]) -> EntityTryInsertMany: ...
    def execute(self, /, connection: Pool | Connection | Transaction) -> Awaitable[_Tried[int]]: ...
    def returning_pk(self, /, connection: Pool | Connection | Transaction) -> Awaitable[_Tried[Any]]: ...
    def returning_model(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[_Tried[EntityModel]]: ...

class EntityTryInsertMany:
    def __init__(self, _native_only: Never, /) -> None: ...
    def on_conflict(self, /, action: Conflict | ConflictUpdate) -> EntityTryInsertMany: ...
    def add(self, /, active: ActiveModel) -> EntityTryInsertMany: ...
    def add_many(self, /, actives: Sequence[ActiveModel]) -> EntityTryInsertMany: ...
    def execute(self, /, connection: Pool | Connection | Transaction) -> Awaitable[_Tried[int]]: ...
    def returning_pks(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[_Tried[list[Any]]]: ...
    def returning_models(
        self, /, connection: Pool | Connection | Transaction
    ) -> Awaitable[_Tried[list[EntityModel]]]: ...
