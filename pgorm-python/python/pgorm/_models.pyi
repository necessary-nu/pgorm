from collections.abc import Callable, Mapping
from typing import Any

from ._statements import Select
from ._writes import Conflict, ConflictUpdate
from ._native import Value

def _model_result_names(prefix: str, columns: list[str]) -> list[str]: ...
def _model_count(select: Select) -> Select: ...

class _ScopeContext:
    def __init__(self, label: str, held: list[tuple[str, object, bool]]) -> None: ...
    @property
    def label(self) -> str: ...

class _ModelScopes:
    def __init__(self, table: str, columns: list[tuple[str, str, str]]) -> None: ...
    @property
    def names(self) -> list[str]: ...
    def check(self, /, cx: _ScopeContext | None) -> None: ...
    def condition(self, /, cx: _ScopeContext | None) -> list[tuple[str, Any]]: ...
    def fill(
        self,
        /,
        cx: _ScopeContext | None,
        row: Mapping[str, Any],
        convert: Callable[[str, Any], Value],
    ) -> list[tuple[str, Value]]: ...
    def upsert(self, /, action: Conflict | ConflictUpdate) -> None: ...
    def immutable(self, /, fields: list[str]) -> None: ...
    @staticmethod
    def column(column: object) -> None: ...
    def join(self, /) -> None: ...
