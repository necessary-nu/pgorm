from .transactions import Transaction
from typing import Any, Never
from collections.abc import Awaitable, Iterator
from ._native import Value
from ._entities import EntityColumn
from .runtime import Connection, Pool

class ActiveState:
    def __init__(self, _native_only: Never, /) -> None: ...
    NotSet: ActiveState
    Set: ActiveState
    Unchanged: ActiveState

class ActiveValue:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def state(self) -> ActiveState: ...
    @property
    def value(self) -> Value | None: ...

class ActiveModel:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def entity_name(self) -> str: ...
    def get(self, /, column: str | EntityColumn) -> ActiveValue: ...
    def set(self, /, column: str | EntityColumn, value: Any) -> ActiveModel: ...
    def not_set(self, /, column: str | EntityColumn) -> ActiveModel: ...
    def reset(self, /, column: str | EntityColumn) -> ActiveModel: ...
    def set_if_not_equals(self, /, column: str | EntityColumn, value: Any) -> ActiveModel: ...
    def is_changed(self, /) -> bool: ...
    def insert(self, /, connection: Pool | Connection | Transaction) -> Awaitable[EntityModel]: ...
    def update(self, /, connection: Pool | Connection | Transaction) -> Awaitable[EntityModel]: ...
    def delete(self, /, connection: Pool | Connection | Transaction) -> Awaitable[int]: ...

class EntityModel:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def entity_name(self) -> str: ...
    def __getitem__(self, key: str, /) -> Any: ...
    def __len__(self, /) -> int: ...
    def __iter__(self, /) -> Iterator[str]: ...
    def keys(self, /) -> tuple[str, ...]: ...
    def values(self, /) -> tuple[Any, ...]: ...
    def items(self, /) -> tuple[tuple[str, Any], ...]: ...
    def tagged(self, /, name: str) -> Value: ...
    def with_value(self, /, column: str | EntityColumn, value: Any) -> EntityModel: ...
    def into_active(self, /) -> ActiveModel: ...
