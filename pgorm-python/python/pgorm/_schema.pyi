from collections.abc import Sequence
from os import PathLike
from typing import Any, Literal, NotRequired, TypeAlias, TypedDict, Never, Unpack
from ._native import TypeName, Compiled
from ._ranges import CreatedRange, CreatedMultirange
from ._expressions import Expr
from ._from_items import Table
from ._entities import Entity
from ._schema_tables import CreateTable, CreateIndex
from ._schema_types import CreateType

Name: TypeAlias = str
BuiltinType: TypeAlias = Literal["char", "varchar", "text", "smallint", "integer", "bigint", "real", "double", "numeric", "boolean", "date", "time", "timestamp", "timestamptz", "interval", "bytea", "bit", "varbit", "money", "json", "jsonb", "uuid", "vector", "cidr", "inet", "macaddr", "ltree", "int4range", "int8range", "numrange", "daterange", "tsrange", "tstzrange", "int4multirange", "int8multirange", "nummultirange", "datemultirange", "tsmultirange", "tstzmultirange"]
ColumnType: TypeAlias = DataType | BuiltinType | TypeName | CreatedRange | CreatedMultirange
TableRef: TypeAlias = Name | Table
TypeRef: TypeAlias = Name | TypeName
KeyColumns: TypeAlias = Name | Sequence[Name]
Behavior: TypeAlias = Literal["cascade", "restrict"]
Deferrability: TypeAlias = Literal["not_deferrable", "deferrable_initially_immediate", "deferrable_initially_deferred"]
Enforcement: TypeAlias = Literal["enforced", "not_enforced"]
ReferentialAction: TypeAlias = Literal["no_action", "restrict", "cascade", "set_null", "set_default"]
CollationName = TypedDict("CollationName", {"name": Name, "schema": NotRequired[Name]})
Collation: TypeAlias = Name | CollationName
SequenceOptions = TypedDict(
    "SequenceOptions",
    {"increment_by": int, "min_value": int | None, "max_value": int | None, "start_with": int, "cache": int, "cycle": bool},
    total=False,
)

IntervalFields: TypeAlias = Literal[
    "year", "month", "day", "hour", "minute", "second", "year_to_month", "day_to_hour",
    "day_to_minute", "day_to_second", "hour_to_minute", "hour_to_second", "minute_to_second",
]

class DataType:
    def __init__(self, kind: BuiltinType | TypeName | CreatedRange | CreatedMultirange, *, length: int | None = ..., precision: int | None = ..., scale: int | None = ..., fields: IntervalFields | None = ...) -> None: ...
    @staticmethod
    def domain(name: Name | TypeName, base: ColumnType) -> DataType: ...
    def array(self, /) -> DataType: ...

class ColumnDef:
    def __init__(self, name: Name, kind: ColumnType | None = ...) -> None: ...
    @property
    def name(self) -> str: ...
    def not_null(self, /, *, name: Name | None = ..., no_inherit: bool = ...) -> ColumnDef: ...
    def null(self, /) -> ColumnDef: ...
    def auto_increment(self, /) -> ColumnDef: ...
    def default(self, /, value: Any) -> ColumnDef: ...
    def check(self, /, condition: Expr, *, name: Name | None = ..., enforcement: Enforcement | None = ..., no_inherit: bool = ...) -> ColumnDef: ...
    def collate(self, /, name: Name, *, schema: Name | None = ...) -> ColumnDef: ...
    def generated(self, /, expression: Expr, kind: Literal["stored", "virtual"]) -> ColumnDef: ...
    def identity(self, /, generation: Literal["always", "by_default"], **options: Unpack[SequenceOptions]) -> ColumnDef: ...

class DDL:
    def __init__(self, _native_only: Never, /) -> None: ...
    def inspect(self, /) -> Compiled: ...

class EntitySchema:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def table(self) -> CreateTable: ...
    @property
    def enums(self) -> list[CreateType]: ...
    @property
    def indexes(self) -> list[CreateIndex]: ...
    @property
    def comments(self) -> list[DDL]: ...

def schema_from_entity(entity: Entity) -> EntitySchema: ...
def _model_schema(table: dict[str, Any], relations: list[dict[str, Any]]) -> EntitySchema: ...
def _model_table(table: dict[str, Any]) -> None: ...
def _renamed(field: str, style: str) -> str: ...

class _ModelColumnCasts:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def compares_as_enum(self) -> bool: ...
    def select(self, /, expr: Expr) -> Expr | None: ...
    def save(self, /, value: Any) -> Expr: ...
    def compared_column(self, /, expr: Expr) -> Expr: ...
    def compared_value(self, /, value: Any) -> Expr: ...

def _model_casts(column: dict[str, Any]) -> _ModelColumnCasts: ...

class MigrationFile:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def text(self) -> str: ...
    @property
    def commits_after(self) -> bool: ...
    def freeze(self, /, directory: str | PathLike[str]) -> bool: ...

def migration_file(
    name: str, statements: Sequence[DDL], *, commits_after: bool = ...
) -> MigrationFile: ...
