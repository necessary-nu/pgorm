from collections.abc import Sequence

from ._native import TypeName

class CopyColumn:
    def __init__(self, name: str, type: str | TypeName, *, money_places: int | None = None) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def type(self) -> TypeName: ...
    @property
    def money_places(self) -> int | None: ...

class CopyRowEncoder:
    def __init__(self, columns: Sequence[CopyColumn]) -> None: ...
    @property
    def columns(self) -> list[CopyColumn]: ...
    @staticmethod
    def header() -> bytes: ...
    @staticmethod
    def trailer() -> bytes: ...
    def encode(self, /, row: Sequence[object]) -> bytes: ...

class CopyRowDecoder:
    def __init__(self, columns: Sequence[CopyColumn]) -> None: ...
    @property
    def columns(self) -> list[CopyColumn]: ...
    def push(self, /, chunk: bytes) -> None: ...
    def next_row(self, /) -> tuple[object, ...] | None: ...
    def finish(self, /) -> None: ...
