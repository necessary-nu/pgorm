from typing import Any, Never
from ._native import Expr, Select

class EntityColumn(Expr):
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def entity_name(self) -> str: ...
    def expr(self, /) -> Expr: ...
    def eq(self, /, other: Any) -> Expr: ...
    def ne(self, /, other: Any) -> Expr: ...
    def gt(self, /, other: Any) -> Expr: ...
    def gte(self, /, other: Any) -> Expr: ...
    def lt(self, /, other: Any) -> Expr: ...
    def lte(self, /, other: Any) -> Expr: ...
    def between(self, /, lower: Any, upper: Any, *, symmetric: bool = ...) -> Expr: ...
    def not_between(self, /, lower: Any, upper: Any, *, symmetric: bool = ...) -> Expr: ...
    def is_distinct_from(self, /, other: Any) -> Expr: ...
    def is_not_distinct_from(self, /, other: Any) -> Expr: ...
    def is_in(self, /, values: list[Any] | tuple[Any, ...] | Select) -> Expr: ...
    def is_not_in(self, /, values: list[Any] | tuple[Any, ...] | Select) -> Expr: ...
    def __eq__(self, value: object, /) -> Expr: ...  # type: ignore[override]
    def __ne__(self, value: object, /) -> Expr: ...  # type: ignore[override]
    def __gt__(self, value: Any, /) -> Expr: ...
    def __ge__(self, value: Any, /) -> Expr: ...
    def __lt__(self, value: Any, /) -> Expr: ...
    def __le__(self, value: Any, /) -> Expr: ...
    def __bool__(self, /) -> bool: ...
