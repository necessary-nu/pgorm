from typing import Any, Never

from ._expressions import Expr
from ._native import Value

class _OneOf:
    def __init__(self, _native_only: Never, /) -> None: ...
    def describe(self, /) -> dict[str, Any]: ...
    def target(self, /, value: str) -> int: ...
    def referenced(self, /, row: list[Value], set: list[bool]) -> int | None: ...
    def assigned(self, /, target: int | None = None) -> list[bool]: ...
    def load_condition(self, /, target: int, keys: list[Value]) -> Expr: ...
    def absent(self, /, target: int, row: list[Value], key: Value) -> Exception: ...
    def statement(self, /) -> Any: ...

def _one_of_model(
    name: str,
    model: tuple[str, dict[str, Any]],
    targets: list[tuple[str, str, str, tuple[str, dict[str, Any]]]],
    optional: bool,
) -> _OneOf: ...
def _one_of_entity(name: str) -> _OneOf: ...
def _one_of_entities() -> list[str]: ...
