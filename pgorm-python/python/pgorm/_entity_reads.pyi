from .transactions import Transaction
from typing import Any, Generic, Literal, Never, TypeVar
from collections.abc import AsyncIterator, Awaitable
from ._native import Compiled, Record
from ._entity_models import EntityModel
from .results import RowStream
from .runtime import Connection, Pool

T = TypeVar("T")

class EntityRelation:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def entity_name(self) -> str: ...
    @property
    def name(self) -> str: ...

class EntitySelection:
    def __init__(self, _native_only: Never, /) -> None: ...
    @property
    def columns(self) -> list[str]: ...
    def inspect(self, /, *, terminal: Literal["all", "one", "optional"] = ...) -> Compiled: ...
    def all(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[Record]]: ...
    def one(self, /, connection: Pool | Connection | Transaction) -> Awaitable[Record]: ...
    def optional(self, /, connection: Pool | Connection | Transaction) -> Awaitable[Record | None]: ...
    def stream(self, /, connection: Pool | Connection) -> Awaitable[RowStream[Record]]: ...
    def __bool__(self, /) -> bool: ...

class EntityPaginator(Generic[T]):
    def __init__(self, _native_only: Never, /) -> None: ...
    def fetch_page(self, /, connection: Pool | Connection | Transaction, page: int) -> Awaitable[list[T]]: ...
    def num_items(self, /, connection: Pool | Connection | Transaction) -> Awaitable[int]: ...
    def num_pages(self, /, connection: Pool | Connection | Transaction) -> Awaitable[int]: ...
    def num_items_and_pages(self, /, connection: Pool | Connection | Transaction) -> Awaitable[tuple[int, int]]: ...
    def pages(self, /, connection: Pool | Connection | Transaction) -> AsyncIterator[list[T]]: ...
    def inspect(self, /, page: int | Literal["count"]) -> Compiled: ...
    def __bool__(self, /) -> bool: ...

class EntityCursor:
    def __init__(self, _native_only: Never, /) -> None: ...
    def before(self, /, *values: Any) -> EntityCursor: ...
    def after(self, /, *values: Any) -> EntityCursor: ...
    def first(self, /, count: int) -> EntityCursor: ...
    def last(self, /, count: int) -> EntityCursor: ...
    def asc(self, /) -> EntityCursor: ...
    def desc(self, /) -> EntityCursor: ...
    def inspect(self, /) -> Compiled: ...
    def all(self, /, connection: Pool | Connection | Transaction) -> Awaitable[list[EntityModel]]: ...
    def __bool__(self, /) -> bool: ...

class _RowDecoder:
    def __init__(self, _native_only: Never, /) -> None: ...
