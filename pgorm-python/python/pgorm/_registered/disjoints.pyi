from collections.abc import Mapping
from typing import Any, Callable, Generic, TypeVar
from ..models.disjoint import DisjointEntity
from ..models.disjoint_query import DisjointQuery, DisjointWrite
from .entities import ActiveView, ModelView

R = TypeVar("R")
K = TypeVar("K", bound=str)
BA = TypeVar("BA", bound=ActiveView[Any])
KA = TypeVar("KA", bound=ActiveView[Any])

def wrap_disjoint_row(
    row: Any, base: type[ModelView[Any]], kinds: dict[str, type[ModelView[Any]] | None]
) -> Any: ...

class DisjointView(Generic[R]):
    _entity: DisjointEntity[Any, R]
    def __init__(self, entity: DisjointEntity[Any, Any], decode: Callable[[Any], R]) -> None: ...
    @property
    def name(self) -> str: ...
    def describe(self) -> dict[str, Any]: ...
    def find(self) -> DisjointQuery[R]: ...
    def find_by_key(self, key: Mapping[str, Any]) -> DisjointQuery[R]: ...

class WritableDisjointView(DisjointView[R], Generic[R, K, BA, KA]):
    def insert(self, base: BA, kind: K, active: KA | None = ...) -> DisjointWrite[R]: ...
    def update(self, base: BA, kind: K, active: KA | None = ...) -> DisjointWrite[R]: ...
    def change_kind(
        self, key: Mapping[str, Any], kind: K, active: KA | None = ...
    ) -> DisjointWrite[R]: ...
