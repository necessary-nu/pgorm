from collections.abc import AsyncIterator
from typing import Any, Callable, Generic, Literal, TypeVar
from .. import _native as native
from ..runtime import Connection, Pool
from ..transactions import Transaction

R = TypeVar("R")

class PaginatorView(Generic[R]):
    def __init__(self, paginator: native.EntityPaginator[Any], decode: Callable[..., R]) -> None: ...
    async def fetch_page(self, connection: Pool | Connection | Transaction, page: int) -> list[R]: ...
    async def num_items(self, connection: Pool | Connection | Transaction) -> int: ...
    async def num_pages(self, connection: Pool | Connection | Transaction) -> int: ...
    async def num_items_and_pages(self, connection: Pool | Connection | Transaction) -> tuple[int, int]: ...
    def pages(self, connection: Pool | Connection | Transaction) -> AsyncIterator[list[R]]: ...
    def inspect(self, page: int | Literal["count"]) -> native.Compiled: ...
    def __bool__(self) -> bool: ...

class CursorView(Generic[R]):
    def __init__(self, cursor: native.EntityCursor, decode: Callable[..., R]) -> None: ...
    def before(self, *values: Any) -> CursorView[R]: ...
    def after(self, *values: Any) -> CursorView[R]: ...
    def first(self, count: int) -> CursorView[R]: ...
    def last(self, count: int) -> CursorView[R]: ...
    def asc(self) -> CursorView[R]: ...
    def desc(self) -> CursorView[R]: ...
    def inspect(self) -> native.Compiled: ...
    async def all(self, connection: Pool | Connection | Transaction) -> list[R]: ...
    def __bool__(self) -> bool: ...
