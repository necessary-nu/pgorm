from typing import Any, Callable, Generic, TypeVar
from collections.abc import Sequence
from .. import _native as native
from ..runtime import Connection, Pool
from ..transactions import Transaction
from .entities import ModelView
from .reads import PaginatorView
from ..results import RowStream

R = TypeVar("R")

def wrap_row(
    row: Any, models: tuple[type[ModelView[Any]], ...], optional: tuple[bool, ...]
) -> Any: ...

class GraphView(Generic[R]):
    def __init__(self, graph: native.EntityGraph, decode: Callable[..., R]) -> None: ...
    @property
    def name(self) -> str: ...
    def describe(self) -> dict[str, Any]: ...
    def find(self, *, aliases: Sequence[str] | None = ...) -> GraphQueryView[R]: ...

class GraphQueryView(Generic[R]):
    def __init__(self, query: native.EntityGraphQuery, decode: Callable[..., R]) -> None: ...
    def col(self, source: int, column: str) -> native.Expr: ...
    def where(
        self, predicate: native.Expr | native.Condition
    ) -> GraphQueryView[R]: ...
    def order_by(self, *ordering: native.OrderBy) -> GraphQueryView[R]: ...
    def inspect(self, *, terminal: str = ...) -> native.Compiled: ...
    def cursor(self, *columns: str) -> GraphCursorView[R]: ...
    def cursor_on(self, source: int, *columns: str) -> GraphCursorView[R]: ...
    async def all(self, connection: Pool | Connection | Transaction) -> list[R]: ...
    async def optional(self, connection: Pool | Connection | Transaction) -> R | None: ...
    async def count(self, connection: Pool | Connection | Transaction) -> int: ...
    def paginate(self, page_size: int) -> PaginatorView[R]: ...
    async def stream(self, connection: Pool | Connection) -> RowStream[R]: ...
    async def all_grouped(self, connection: Pool | Connection | Transaction) -> list[tuple[Any, list[Any]]]: ...
    def __bool__(self) -> bool: ...

class GraphCursorView(Generic[R]):
    def __init__(
        self, cursor: native.EntityGraphCursor, decode: Callable[..., R]
    ) -> None: ...
    def before(self, *values: Any) -> GraphCursorView[R]: ...
    def after(self, *values: Any) -> GraphCursorView[R]: ...
    def before_with(self, *values: Any) -> GraphCursorView[R]: ...
    def after_with(self, *values: Any) -> GraphCursorView[R]: ...
    def first(self, count: int) -> GraphCursorView[R]: ...
    def last(self, count: int) -> GraphCursorView[R]: ...
    def asc(self) -> GraphCursorView[R]: ...
    def desc(self) -> GraphCursorView[R]: ...
    def inspect(self) -> native.Compiled: ...
    async def all(self, connection: Pool | Connection | Transaction) -> list[R]: ...
    def __bool__(self) -> bool: ...
