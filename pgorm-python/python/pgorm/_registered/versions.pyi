from collections.abc import Sequence
from typing import Any, Generic, TypeVar
from .. import _native as native_types
from .entities import ActiveView
from ..runtime import Connection, Pool
from ..transactions import Transaction

M = TypeVar("M")
Column = str | native_types.EntityColumn

class UpdateView(Generic[M]):
    def __init__(self, update: native_types.EntityUpdate, model: type[M]) -> None: ...
    async def returning_change(self, connection: Pool | Connection | Transaction) -> native_types.Change[M]: ...
    def __bool__(self) -> bool: ...

class UpdateManyView(Generic[M]):
    def __init__(self, update: native_types.EntityUpdateMany, model: type[M]) -> None: ...
    def set(self, column: Column, value: Any) -> UpdateManyView[M]: ...
    def where(self, predicate: native_types.Expr | native_types.Condition) -> UpdateManyView[M]: ...
    def all_rows(self) -> UpdateManyView[M]: ...
    async def returning_changes(self, connection: Pool | Connection | Transaction) -> list[native_types.Change[M]]: ...
    def __bool__(self) -> bool: ...

Active = native_types.ActiveModel | ActiveView[Any]

class InsertView(Generic[M]):
    def __init__(self, insert: native_types.EntityInsert, model: type[M]) -> None: ...
    def on_conflict(
        self, action: native_types.Conflict | native_types.ConflictUpdate
    ) -> InsertView[M]: ...
    def add(self, active: Active) -> InsertManyView[M]: ...
    def add_many(self, actives: Sequence[Active]) -> InsertManyView[M]: ...
    async def execute(self, connection: Pool | Connection | Transaction) -> int: ...
    async def returning_pk(self, connection: Pool | Connection | Transaction) -> Any: ...
    async def returning_model(self, connection: Pool | Connection | Transaction) -> M: ...
    async def returning_upsert(
        self, connection: Pool | Connection | Transaction
    ) -> native_types.Upserted.Inserted[M] | native_types.Upserted.Updated[M] | None: ...
    def __bool__(self) -> bool: ...

class InsertManyView(Generic[M]):
    def __init__(self, insert: native_types.EntityInsertMany, model: type[M]) -> None: ...
    def on_conflict(
        self, action: native_types.Conflict | native_types.ConflictUpdate
    ) -> InsertManyView[M]: ...
    def add(self, active: Active) -> InsertManyView[M]: ...
    def add_many(self, actives: Sequence[Active]) -> InsertManyView[M]: ...
    async def execute(self, connection: Pool | Connection | Transaction) -> int: ...
    async def returning_pks(self, connection: Pool | Connection | Transaction) -> list[Any]: ...
    async def returning_models(self, connection: Pool | Connection | Transaction) -> list[M]: ...
    async def returning_upserts(
        self, connection: Pool | Connection | Transaction
    ) -> list[native_types.Upserted.Inserted[M] | native_types.Upserted.Updated[M]]: ...
    def __bool__(self) -> bool: ...
