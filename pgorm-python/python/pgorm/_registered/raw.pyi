from typing import Any, Generic, TypeVar
from .. import _native as native_types
from ..runtime import Connection, Pool
from ..transactions import Transaction
from .entities import ModelView

M = TypeVar("M", bound=ModelView[Any])

class RawQueryView(Generic[M]):
    def __init__(self, query: native_types.EntityRawQuery, model: type[M]) -> None: ...
    def inspect(self) -> native_types.Compiled: ...
    async def all(self, connection: Pool | Connection | Transaction) -> list[M]: ...
    async def one(self, connection: Pool | Connection | Transaction) -> M: ...
    async def optional(self, connection: Pool | Connection | Transaction) -> M | None: ...
    def __bool__(self) -> bool: ...
