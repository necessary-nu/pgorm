    {"kind": "datetime", "postgres": "pg_catalog.timestamp", "result_kind": "datetime", "policy": "live"},
    {"kind": "datetime_utc", "postgres": "pg_catalog.timestamptz", "result_kind": "datetime_utc", "policy": "live"},
