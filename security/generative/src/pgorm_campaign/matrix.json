  "array_contexts": ["empty", "sql-null", "nullable-elements", "bound"],
  "value_exclusions": [
    {"space": "value", "kind": "u64", "context": "result-decode", "reason": "PostgreSQL has no unsigned 64-bit type, so no column can carry one back. The native Record decoder maps int8 to i64 and oid to u32 and never emits a u64 tag (pgorm-python/src/results/decode.rs), and u64 is named in the capability manifest's unsupported_kinds. Construction and explicit wire rejection stay required; a decode cell cannot exist."},
    {"space": "value", "kind": "char", "context": "result-decode", "reason": "This row already declares result_kind text: a Rust Unicode char is carried by a PostgreSQL text column and comes back tagged text, so a decoded value can never carry the char tag. The row's own reason limits the char tag to construction evidence, and that context stays required. Retiring only the decode cell; literal, bound and typed-null remain."},
    {"space": "value", "kind": "vector", "context": "result-decode", "reason": "The pinned PostgreSQL image ships no pgvector extension, so no column can have type vector and no row can decode as one. The decoder does handle a vector-named type, so this is an environment bound rather than a missing decode path; restoring it means adding the extension to the fixture image, not a generator rule."}
  ],
  "hostile_contexts": ["value", "identifier", "pattern", "stored-value", "stored-identifier"],
  "hostile_features": ["quote", "comment", "separator", "dollar-string", "backslash", "unicode", "wildcard", "numeric-boundary"],
  "registered_entities": ["campaign.Account", "campaign.Note", "campaign.Room", "campaign.Stay"],
  "registered_graphs": ["campaign.AccountOnly", "campaign.OptionalNotes", "campaign.RequiredNotes", "campaign.SelfJoin", "campaign.Arity3", "campaign.Arity4", "campaign.Arity5", "campaign.Arity6", "campaign.Arity7", "campaign.StayRooms", "campaign.StayGuests"],
  "registered_sources": ["campaign.Sources1", "campaign.Sources2", "campaign.Sources3", "campaign.Sources4", "campaign.Sources5", "campaign.Sources6"],
  "outside_runtime": [
    {"id": "new-rust-entities", "status": "compile-only", "rust": ["pgorm::Entity", "pgorm::Disjoint", "pgorm_codegen::EntityWriter"], "reason": "Installed entity registrations fix Rust types; fresh derives and codegen shapes require the bounded compile suite."},
    {"id": "rust-ownership", "status": "compile-only", "rust": ["pgorm::DatabaseTransaction", "pgorm::pipeline::Binder"], "reason": "Rust borrow and branded lifetime rejection requires compiling negative source programs; Python scope checks are separately exercised."},
    {"id": "fresh-graph-generics", "status": "compile-only", "rust": ["pgorm::SelectGraph", "pgorm::pipeline::SourceList"], "reason": "Runtime programs vary registered shapes; new tuple/generic instantiations belong to the compile suite."},
    {"id": "select-subquery-constructor", "status": "unsupported", "rust": ["pgorm_query::SelectStatement::from_subquery"], "reason": "The public Python Select surface lacks this constructor. Generated query nesting uses real pipeline composition and nested sources; it must not claim this missing Select method."},
    {"id": "transaction-stream", "status": "unsupported", "rust": ["pgorm::DatabaseTransaction::query_raw"], "reason": "The public Python transaction surface has no stream terminal. Runtime streams use pool or connection ownership."},
    {"id": "pgvector-wire", "status": "construction-or-rejection", "rust": ["pgorm_query::Value::Vector"], "reason": "The pinned PostgreSQL image has no pgvector extension. Value construction preserves f32 elements; live unsupported type/decode cases must report the expected rejection."},
    {"id": "unsigned64-column", "status": "construction-or-rejection", "rust": ["pgorm_query::Value::BigUnsigned"], "reason": "The Rust value variant has no native PostgreSQL unsigned 64-bit column counterpart. Construction and explicit wire rejection are separate from supported integer round trips."},
    {"id": "range-values", "status": "unsupported", "rust": ["pgorm_query::Value::Multirange", "pgorm_query::extension::TypeCreateStatement::as_range"], "reason": "A built-in range travels the wire as pgorm's own snapshot of one (wire.RANGES): campaign.Room's key and campaign.Stay carry daterange periods through entity writes, key lookups and a PERIOD join. A range is not a value-matrix scalar, its bounds are. Multiranges and a range type a schema creates still have no portable kind, so no generated program constructs, binds or decodes one; Rust's own live suites carry those round trips."}
  ]
}
